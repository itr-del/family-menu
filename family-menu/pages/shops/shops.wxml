<!-- pages/shops/shops.wxml · 大家喜欢的餐厅 -->
<view
  class="root"
  style="--primary:{{theme.primary || '#E8543F'}};--primary-dark:{{theme.primaryDark || '#C9402D'}};--soft:{{theme.soft || '#FFF1EE'}};--bg:{{theme.bg || '#F6F4F1'}};--text:{{theme.text || '#2B2B2B'}};--sub:{{theme.sub || '#8A8A8A'}};--card:{{theme.card || '#FFFFFF'}}"
>
  <view class="head">
    <view class="head-t">{{cfgTitle}}</view>
    <view class="head-s">{{list.length}} 家 · {{cfgSub}}</view>
  </view>

  <view class="list">
    <view class="shop" wx:for="{{list}}" wx:key="id">
      <view class="logo" data-src="{{item.logoImage}}" bindtap="previewLogo">
        <image wx:if="{{item.logoImage}}" class="logo-img" src="{{item.logoImage}}" mode="aspectFill" />
        <text wx:else class="logo-e">{{item.logo}}</text>
      </view>

      <view class="mid">
        <view class="name">{{item.name}}</view>

        <view class="tags" wx:if="{{item.tags && item.tags.length}}">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>

        <view class="addr" wx:if="{{item.address}}">{{item.address}}</view>
        <view class="addr unset" wx:else>还没标位置</view>

        <view class="likes" wx:if="{{item.likesText}}">
          <text class="heart">♥</text>{{item.likesText}}
        </view>
      </view>

      <view class="ops">
        <view class="op nav" data-i="{{index}}" catchtap="navigate">导航</view>
        <view class="op edit" data-i="{{index}}" catchtap="openEdit">改</view>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <text class="empty-e">🍜</text>
      <view class="empty-t">{{text.shopsEmpty}}</view>
      <view class="empty-s">{{text.shopsEmptyTip}}</view>
    </view>
  </view>

  <view class="spacer"></view>

  <view class="foot">
    <view class="add" bindtap="openNew">＋ 加一家餐厅</view>
    <view class="safe-bottom"></view>
  </view>

  <!-- ============ 编辑弹层 ============ -->
  <view class="mask" wx:if="{{showEditor}}" bindtap="closeEdit"></view>
  <view class="editor" wx:if="{{showEditor}}">
    <view class="ed-head">
      <text class="ed-title">{{form.id ? '改一改' : '加一家餐厅'}}</text>
      <text class="ed-close" bindtap="closeEdit">✕</text>
    </view>

    <scroll-view class="ed-body" scroll-y>
      <!-- logo -->
      <view class="fld">
        <view class="fld-t">店标</view>
        <view class="logo-row">
          <view class="logo-pick" bindtap="pickLogo">
            <image wx:if="{{form.logoImage}}" class="logo-pick-img" src="{{form.logoImage}}" mode="aspectFill" />
            <text wx:else class="logo-pick-e">{{form.logo || '＋'}}</text>
          </view>
          <view class="logo-tips">
            <view class="lt-1" bindtap="pickLogo">从相册选一张</view>
            <view class="lt-2" wx:if="{{form.logoImage}}" bindtap="removeLogo">移除图片，用 emoji</view>
            <view class="lt-2" wx:else>没图就先用 emoji 顶着，下面能选</view>
          </view>
        </view>
        <view class="chips" style="margin-top:16rpx">
          <text
            class="emoji {{form.logo === e ? 'on' : ''}}"
            wx:for="{{emojis}}"
            wx:key="*this"
            data-v="{{e}}"
            bindtap="pickEmoji"
            >{{e}}</text
          >
        </view>
      </view>

      <!-- 店名 -->
      <view class="fld">
        <view class="fld-t">店名</view>
        <input class="fld-in" value="{{form.name}}" placeholder="比如 楼下那家面馆" bindinput="onInput" data-k="name" maxlength="24" />
      </view>

      <!-- 位置 -->
      <view class="fld">
        <view class="fld-t">位置</view>
        <view class="loc" bindtap="pickLocation">
          <view class="loc-l">
            <view class="loc-a">{{form.address || '点这里在地图上选一下'}}</view>
            <view class="loc-c" wx:if="{{form.latitude}}">已标注 · 可导航</view>
          </view>
          <text class="loc-btn">{{form.latitude ? '重选' : '选位置'}}</text>
        </view>
      </view>

      <!-- 标签 -->
      <view class="fld">
        <view class="fld-t">标签（可多选）</view>
        <view class="chips">
          <text
            class="chip {{form._tagMap[t] ? 'on' : ''}}"
            wx:for="{{allTags}}"
            wx:key="*this"
            data-v="{{t}}"
            bindtap="toggleTag"
            >{{t}}</text
          >
        </view>
      </view>

      <!-- 谁喜欢 -->
      <view class="fld">
        <view class="fld-t">谁喜欢</view>
        <view class="chips">
          <text
            class="chip {{form._likeMap[m] ? 'on' : ''}}"
            wx:for="{{members}}"
            wx:key="*this"
            data-v="{{m}}"
            bindtap="toggleLike"
            >{{m}}</text
          >
        </view>
      </view>

      <!-- 备注 -->
      <view class="fld">
        <view class="fld-t">备注（可空）</view>
        <input class="fld-in" value="{{form.note}}" placeholder="比如 周末人多，早点去" bindinput="onInput" data-k="note" maxlength="40" />
      </view>

      <view class="ed-pad"></view>
    </scroll-view>

    <view class="ed-foot">
      <view class="ed-del" wx:if="{{form.id}}" bindtap="del">删掉</view>
      <view class="ed-cancel" bindtap="closeEdit">取消</view>
      <view class="ed-save" bindtap="save">保存</view>
    </view>
  </view>
</view>
